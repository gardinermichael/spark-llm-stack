#!/usr/bin/env bash
# docker-llm-switch — Docker-native equivalent of llm-switch.
# Same UX, but manages spark-llm-stack containers instead of systemd user units.
#
# Runtime commands:
#   docker-llm-switch [coder|architect|gemma|vision|gptoss|imagine|comfyui]
#   docker-llm-switch <slot> stop                  stop only that slot
#   docker-llm-switch <slot> restart               recreate that slot (applies config changes)
#   docker-llm-switch off
#   docker-llm-switch status
#   docker-llm-switch <slot> config               show tunable options + active overrides
#   docker-llm-switch <slot> config <flag> <val>  persist a runtime override
#   docker-llm-switch <slot> config --reset [flag] clear one or all overrides
#
# Boot-state commands (Docker analogue):
#   docker-llm-switch boot-safe              remove --restart from all slots
#   docker-llm-switch boot-default <slot>    set ONE slot to start at Docker daemon boot
#   docker-llm-switch boot-status            show which slot will auto-start at boot
#
# Mutual exclusion: starting a slot stops only weight-class conflicts
# (heavyweight pairs are exclusive — POSTMORTEM); lightweights coexist.
# See `Coexistence policy` in docker/README.md.
#
# Slot coverage: all seven slots are managed here — five llama.cpp slots
# (coder/architect/gemma/vision/gptoss) share the spark-llm-stack image, plus
# imagine (FLUX via spark-llm-imagine, built from docker/sd-server) and
# comfyui (spark-llm-comfyui, built from docker/comfyui).

set -euo pipefail

MODELS_DIR="${MODELS_DIR:-$HOME/models}"
COMFY_DIR="${COMFY_DIR:-$HOME/comfyui}"
PREFIX="spark-llm-"
WAIT_TIMEOUT=300

SLOTS=(coder architect gemma vision gptoss imagine comfyui)

# Single source of truth for the user-shell CLI tools this script knows
# about. Format: "name:relpath-from-repo-root". Consumed by the health
# section (presence + drift + remediation). The repo-side installer
# (`tools/install-user-cli.sh`) keeps its own copy; mismatches there will
# show up as drift/missing rows in `health` output rather than silently
# diverge.
USER_CLI_TOOLS=(
  "docker-llm-switch:docker/docker-llm-switch"
  "llm-switch:systemd/llm-switch"
  "flux-gen:tools/flux-gen"
  "tok-log:tools/tok-log"
)

# ── config override storage ───────────────────────────────────────────────────
# Per-slot overrides live in CONF_DIR/overrides/<slot>, one "flag=value" per line.
# docker_run_slot applies these on top of the built-in CMD_<slot> arrays.
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/docker-llm-switch"

# ── cross-stack failsafe library (docker/lib/spark-mem.sh) ────────────────────
#
# Provides: spark_acquire_lock, spark_admission_check,
# spark_cross_stack_stop_others, spark_drop_caches, spark_panic_stop_all,
# spark_parse_gb. See docker/lib/spark-mem.sh for rationale.
_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SPARK_MEM_LIB="${SPARK_MEM_LIB:-$_SCRIPT_DIR/lib/spark-mem.sh}"
if [ ! -r "$SPARK_MEM_LIB" ]; then
  # When installed to ~/.local/bin the lib is no longer adjacent — check the
  # standard install locations.
  for _cand in /usr/local/lib/spark-mem.sh /etc/spark-llm-stack/spark-mem.sh \
               "$HOME/spark-llm-stack/docker/lib/spark-mem.sh"; do
    [ -r "$_cand" ] && SPARK_MEM_LIB="$_cand" && break
  done
fi
if [ -r "$SPARK_MEM_LIB" ]; then
  # shellcheck source=lib/spark-mem.sh
  . "$SPARK_MEM_LIB"
else
  echo "docker-llm-switch: warning — spark-mem.sh not found; failsafe shims active" >&2
  spark_acquire_lock() { :; }
  spark_admission_check() { return 0; }
  spark_cross_stack_stop_others() { :; }
  spark_drop_caches() { sudo sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches' 2>/dev/null || true; }
  spark_panic_stop_all() {
    echo "spark-panic shim: stopping every spark-* docker container" >&2
    docker ps -q --filter "name=spark-" | xargs -r docker stop -t 10 >/dev/null 2>&1 || true
  }
  spark_parse_gb() {
    local r="${1:-0}"
    r=$(printf '%s' "$r" | tr '[:upper:]' '[:lower:]')
    # %%g* greedy-strips everything from the first 'g' so "40gb" -> "40", not "40b".
    case "$r" in *gb|*g) echo "${r%%g*}" ;; *) echo 0 ;; esac
  }
fi

declare -A PORTS=(
  [coder]=8152 [architect]=8154 [gemma]=8156 [vision]=8155 [gptoss]=8157
  [imagine]=8160 [comfyui]=8188
)
declare -A ROLES=(
  [coder]="qwen3.6-27B    fast coding, MTP 70%+"
  [architect]="qwen3.6-35B    deep reasoning, MoE"
  [gemma]="gemma4-31B     alt reasoning + image input"
  [vision]="gemma4-E4B     fast vision + audio input"
  [gptoss]="gpt-oss-20B    fast general, OpenAI style"
  [imagine]="flux.2-klein  image generation (sd-server)"
  [comfyui]="ComfyUI       diffusion UI + workflows"
)
declare -A MEMCAP=(
  [coder]=80g [architect]=80g [gemma]=80g [vision]=20g [gptoss]=40g
  [imagine]=16g [comfyui]=40g
)
declare -A MEMSOFT=(
  [coder]=70g [architect]=70g [gemma]=70g [vision]=15g [gptoss]=30g
  [imagine]=12g [comfyui]=30g
)
# Weight class — mirrors the `heavyweight` column in systemd/harden-llm-stack.sh
# (heavyweights are the LLM slots that go into the Conflicts= pool there).
# Heavyweight pairs are mutually exclusive at runtime; lightweights can
# coexist with each other and with one heavyweight subject to the admission
# gate. See POSTMORTEM: two heavyweights together (~160GiB) caused the OOM
# brick loop; lightweight pairs (vision 20G + imagine 16G + comfyui 40G) all
# fit comfortably on a 121 GiB unified pool.
declare -A HEAVY=(
  [coder]=1 [architect]=1 [gemma]=1 [gptoss]=1
  [vision]=0 [imagine]=0 [comfyui]=0
)
# Per-slot image. Llama slots all share one image (different CMD per slot);
# imagine and comfyui get their own images built from docker/sd-server and
# docker/comfyui respectively. Override individually via SPARK_IMAGE_<slot>.
declare -A IMAGE=(
  [coder]="${SPARK_IMAGE:-spark-llm-stack}"
  [architect]="${SPARK_IMAGE:-spark-llm-stack}"
  [gemma]="${SPARK_IMAGE:-spark-llm-stack}"
  [vision]="${SPARK_IMAGE:-spark-llm-stack}"
  [gptoss]="${SPARK_IMAGE:-spark-llm-stack}"
  [imagine]="${SPARK_IMAGE_IMAGINE:-spark-llm-imagine}"
  [comfyui]="${SPARK_IMAGE_COMFYUI:-spark-llm-comfyui}"
)

