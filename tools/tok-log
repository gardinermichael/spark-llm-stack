def db_connect():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH))
    conn.executescript(SCHEMA)
    conn.executescript(SAMPLES_SCHEMA)
    # Forward-compat: if an older DB existed, add any missing columns.
    existing = {r[1] for r in conn.execute("PRAGMA table_info(runs)").fetchall()}
    wanted = {
        "session_id": "TEXT",
        "model_name": "TEXT", "model_hf": "TEXT",
        "n_batch": "INTEGER", "n_ubatch": "INTEGER", "n_parallel": "INTEGER",
        "n_gpu_layers": "INTEGER", "flash_attn": "TEXT",
        "cache_type_k": "TEXT", "cache_type_v": "TEXT", "cache_ram": "INTEGER",
        "cache_reuse": "INTEGER", "ctx_checkpoints": "INTEGER",
        "kv_unified": "INTEGER", "spec_type": "TEXT",
        "spec_draft_n_max": "INTEGER", "spec_draft_n_min": "INTEGER",
        "spec_draft_p_min": "REAL",
        "threads": "INTEGER", "threads_batch": "INTEGER",
        "temp": "REAL", "top_k": "INTEGER", "top_p": "REAL", "min_p": "REAL",
        "reasoning": "TEXT", "reasoning_budget": "INTEGER",
        "reasoning_format": "TEXT",
        "cmd_source": "TEXT", "cmd_argv": "TEXT", "flags": "TEXT",
        "overrides": "TEXT",
    }
    for col, typ in wanted.items():
        if col not in existing:
            conn.execute(f"ALTER TABLE runs ADD COLUMN {col} {typ}")
    conn.executescript(INDEXES)
    return conn


# ── HTTP helpers ──────────────────────────────────────────────────────────────

def http_get_json(url, timeout=10):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def http_post_json(url, payload, timeout=600):
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url, data=data, headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


# ── effective-argv discovery ──────────────────────────────────────────────────

# Flags that take a value. Anything not in here is treated as a boolean
# present-flag (stored as True in the flag map).
VALUE_FLAGS = {
    "-m", "-hf", "--alias", "--host", "--port", "-c", "-b", "-ub", "-ngl",
    "--cache-type-k", "--cache-type-v", "--cache-ram", "--cache-reuse",
    "--ctx-checkpoints", "--parallel", "--threads", "--threads-batch",
    "--threads-http", "--prio", "--poll", "--spec-type",
    "--spec-draft-n-max", "--spec-draft-n-min", "--spec-draft-p-min",
    "--reasoning", "--reasoning-budget", "--reasoning-format",
    "--temp", "--top-k", "--top-p", "--min-p", "--presence-penalty",
    "--keep", "-fa",
}


def parse_argv_to_flags(argv):
    """Return (flag_map, model_name, model_path, model_hf).

    Flags that take a value map to their string value; bare flags map to True.
    """
    flags = {}
    i = 0
    while i < len(argv):
        tok = argv[i]
        if not tok.startswith("-"):
            i += 1
            continue
        if tok in VALUE_FLAGS and i + 1 < len(argv):
            flags[tok] = argv[i + 1]
            i += 2
        else:
            flags[tok] = True
            i += 1

    model_path = flags.get("-m") if isinstance(flags.get("-m"), str) else None
    model_hf = flags.get("-hf") if isinstance(flags.get("-hf"), str) else None
    if model_path:
        model_name = os.path.basename(model_path)
    elif model_hf:
        model_name = model_hf
    else:
        model_name = None
    return flags, model_name, model_path, model_hf


def docker_inspect_cmd(slot):
    """Return (argv, session_id) for the running container, or (None, None)."""
    if not shutil.which("docker"):
        return None, None
    name = f"{CONTAINER_PREFIX}{slot}"
    try:
        out = subprocess.run(
            ["docker", "inspect", "--format",
             "{{json .Config.Entrypoint}}|{{json .Config.Cmd}}|"
             "{{.Id}}|{{.State.StartedAt}}", name],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (subprocess.SubprocessError, FileNotFoundError):
        return None, None
    if out.returncode != 0:
        return None, None
    line = (out.stdout or "").strip()
    parts = line.split("|", 3)
    if len(parts) < 4:
        return None, None
    ep_raw, cmd_raw, cid, started = parts
    try:
        ep = json.loads(ep_raw) or []
        cm = json.loads(cmd_raw) or []
    except json.JSONDecodeError:
        return None, None
    argv = list(ep) + list(cm)
    sess = f"{slot}:{cid[:12]}:{started}" if cid and started else None
    return (argv if argv else None), sess


def systemd_show_cmd(slot):
    """Return (argv, session_id) for the running unit, or (None, None)."""
    unit = UNITS.get(slot)
    if not unit or not shutil.which("systemctl"):
        return None, None
    try:
        out = subprocess.run(
            ["systemctl", "--user", "show", unit,
             "-p", "ExecStart",
             "-p", "MainPID",
             "-p", "ActiveEnterTimestamp"],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (subprocess.SubprocessError, FileNotFoundError):
        return None, None
    if out.returncode != 0:
        return None, None
    text = out.stdout or ""
    # ExecStart=...{ path=<bin> ; argv[]=<bin> <arg1> <arg2> ... ; ...}
    marker = "argv[]="
    idx = text.find(marker)
    argv = None
    if idx >= 0:
        tail = text[idx + len(marker):]
        end = tail.find(" ; ")
        if end >= 0:
            tail = tail[:end]
        argv = tail.strip().split() or None

    pid = ""
    started = ""
    for line in text.splitlines():
        if line.startswith("MainPID="):
            pid = line.split("=", 1)[1].strip()
        elif line.startswith("ActiveEnterTimestamp="):
            started = line.split("=", 1)[1].strip()
    sess = f"{slot}:pid{pid}:{started}" if pid and pid != "0" else None
    return argv, sess


def load_overrides(slot):
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    conf = base / "docker-llm-switch" / "overrides" / slot
    if not conf.is_file():
        return {}
    out = {}
    for line in conf.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip()
    return out


def _f(flags, key, conv, default=None):
    v = flags.get(key)
    if v is None or v is True:
        return default
    try:
        return conv(v)
    except (TypeError, ValueError):
        return default


# ── bench ─────────────────────────────────────────────────────────────────────

def cmd_bench(args):
    if args.slot not in PORTS:
        sys.exit(f"unknown slot {args.slot!r}; known: {', '.join(PORTS)}")
    port = PORTS[args.slot]
    host = args.host
    base = f"http://{host}:{port}"

    prompt = args.prompt or DEFAULT_PROMPT

    # /props is best-effort — older builds may not return everything we use.
    props = {}
    try:
        props = http_get_json(f"{base}/props", timeout=5)
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"server unreachable at {base}/props: {e}")

    # Discover effective argv + session id.
    argv = None
    session_id = None
    cmd_source = "none"
    if not args.no_docker:
        argv, session_id = docker_inspect_cmd(args.slot)
        if argv:
            cmd_source = "docker"
    if argv is None and not args.no_systemd:
        argv, session_id = systemd_show_cmd(args.slot)
        if argv:
            cmd_source = "systemd"

    flags, model_name, model_path_arg, model_hf = ({}, None, None, None)
    if argv:
        flags, model_name, model_path_arg, model_hf = parse_argv_to_flags(argv)

    overrides = load_overrides(args.slot)

    # Run the benchmark.
    payload = {
        "prompt": prompt,
        "n_predict": args.n_predict,
        "cache_prompt": False,
        "stream": False,
    }
    t0 = time.monotonic()
    err = None
    resp = {}
    try:
        resp = http_post_json(f"{base}/completion", payload, timeout=args.timeout)
    except Exception as e:
        err = f"{type(e).__name__}: {e}"
    wall_ms = (time.monotonic() - t0) * 1000.0

    timings = resp.get("timings", {}) if isinstance(resp, dict) else {}
    gen = resp.get("generation_settings", {}) if isinstance(resp, dict) else {}

    # Fall back to /props for model identity if argv didn't yield it.
    model_path = model_path_arg or props.get("model_path") or gen.get("model")
    model_alias = (
        flags.get("--alias") if isinstance(flags.get("--alias"), str) else None
        or gen.get("model_alias")
        or props.get("default_generation_settings", {}).get("model_alias")
        or props.get("model_alias")
    )
    if not model_name and isinstance(model_path, str):
        model_name = os.path.basename(model_path)

    # n_ctx: prefer argv, then /props, then gen settings.
    n_ctx = _f(flags, "-c", int)
    if n_ctx is None:
        n_ctx = (
            gen.get("n_ctx")
            or props.get("default_generation_settings", {}).get("n_ctx")
            or props.get("n_ctx")
        )

    row = {
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "slot": args.slot, "port": port, "host": host, "tag": args.tag,
        "session_id": session_id,

        "model_name": model_name,
        "model_alias": model_alias,
        "model_path": model_path,
        "model_hf": model_hf,

        "n_ctx": n_ctx,
        "n_batch": _f(flags, "-b", int),
        "n_ubatch": _f(flags, "-ub", int),
        "n_parallel": _f(flags, "--parallel", int),
        "n_gpu_layers": _f(flags, "-ngl", int),
        "flash_attn": (flags.get("-fa") if isinstance(flags.get("-fa"), str)
                       else ("on" if flags.get("-fa") is True else None)),
        "cache_type_k": _f(flags, "--cache-type-k", str),
        "cache_type_v": _f(flags, "--cache-type-v", str),
        "cache_ram": _f(flags, "--cache-ram", int),
        "cache_reuse": _f(flags, "--cache-reuse", int),
        "ctx_checkpoints": _f(flags, "--ctx-checkpoints", int),
        "kv_unified": 1 if flags.get("--kv-unified") else 0 if flags else None,
        "spec_type": _f(flags, "--spec-type", str),
        "spec_draft_n_max": _f(flags, "--spec-draft-n-max", int),
        "spec_draft_n_min": _f(flags, "--spec-draft-n-min", int),
        "spec_draft_p_min": _f(flags, "--spec-draft-p-min", float),
        "threads": _f(flags, "--threads", int),
        "threads_batch": _f(flags, "--threads-batch", int),
        "temp": _f(flags, "--temp", float),
        "top_k": _f(flags, "--top-k", int),
        "top_p": _f(flags, "--top-p", float),
        "min_p": _f(flags, "--min-p", float),
        "reasoning": _f(flags, "--reasoning", str),
        "reasoning_budget": _f(flags, "--reasoning-budget", int),
        "reasoning_format": _f(flags, "--reasoning-format", str),

        "n_predict_req": args.n_predict,
        "prompt_tokens": timings.get("prompt_n"),
        "predicted_tokens": timings.get("predicted_n"),
        "prompt_ms": timings.get("prompt_ms"),
        "predicted_ms": timings.get("predicted_ms"),
        "prompt_per_second": timings.get("prompt_per_second"),
        "predicted_per_second": timings.get("predicted_per_second"),
        "wall_ms": wall_ms,

        "prompt": prompt,
        "cmd_source": cmd_source,
        "cmd_argv": json.dumps(argv) if argv else None,
        "flags": json.dumps(flags, sort_keys=True, default=str) if flags else None,
        "overrides": json.dumps(overrides, sort_keys=True) if overrides else None,
        "generation_settings": json.dumps(gen, sort_keys=True) if gen else None,
        "props": json.dumps(props, sort_keys=True) if props else None,
        "timings": json.dumps(timings, sort_keys=True) if timings else None,
        "error": err,
    }

    cols = ", ".join(row.keys())
    placeholders = ", ".join(["?"] * len(row))
    conn = db_connect()
    with conn:
        cur = conn.execute(
            f"INSERT INTO runs ({cols}) VALUES ({placeholders})",
            list(row.values()),
        )
        run_id = cur.lastrowid

    if err:
        print(f"[#{run_id}] {args.slot} ERROR: {err}")
        sys.exit(1)

    pps = timings.get("predicted_per_second")
    pps_s = f"{pps:.2f} tok/s" if isinstance(pps, (int, float)) else "n/a"
    prs = timings.get("prompt_per_second")
    prs_s = f"{prs:.2f} tok/s" if isinstance(prs, (int, float)) else "n/a"
    model_label = model_name or model_alias or "?"
    extras = []
    if row["spec_draft_n_max"] is not None:
        extras.append(f"n_max={row['spec_draft_n_max']}")
    if row["cache_type_k"] or row["cache_type_v"]:
        extras.append(f"kv={row['cache_type_k']}/{row['cache_type_v']}")
    if row["n_ctx"]:
        extras.append(f"ctx={row['n_ctx']}")
    extra_s = ("  " + " ".join(extras)) if extras else ""
    print(f"[#{run_id}] {args.slot}  {model_label}  src={cmd_source}{extra_s}")
    print(f"         predicted={timings.get('predicted_n')} @ {pps_s}  "
          f"prompt={timings.get('prompt_n')} @ {prs_s}  wall={wall_ms:.0f}ms")


# ── list / show / db-path ─────────────────────────────────────────────────────

def cmd_list(args):
    conn = db_connect()
    q = ("SELECT id, ts, slot, model_name, n_ctx, spec_draft_n_max, "
         "cache_type_k, cache_type_v, "
         "prompt_tokens, predicted_tokens, "
         "predicted_per_second, prompt_per_second, tag, session_id, error "
         "FROM runs")
    params = []
    wheres = []
    if args.slot:
        wheres.append("slot = ?"); params.append(args.slot)
    if args.model:
        wheres.append("model_name LIKE ?"); params.append(f"%{args.model}%")
    if args.session:
        wheres.append("session_id = ?"); params.append(args.session)
    if wheres:
        q += " WHERE " + " AND ".join(wheres)
    q += " ORDER BY id DESC LIMIT ?"
    params.append(args.limit)

    rows = conn.execute(q, params).fetchall()
    if not rows:
        print("(no runs)")
        return

    print(f"  {'id':>4}  {'ts':<20}  {'slot':<10}  {'model':<28}  "
          f"{'ctx':>6}  {'nmax':>4}  {'kv':<9}  "
          f"{'pp tok':>7}  {'gen tok':>7}  {'gen t/s':>8}  {'pp t/s':>8}  "
          f"{'sess':<14}  tag")
    for r in rows:
        (rid, ts, slot, model, ctx, nmax, ck, cv,
         pt, gt, pps, prs, tag, sess, err) = r
        model = (model or "?")[:28]
        kv = f"{ck or '-'}/{cv or '-'}"[:9]
        tag = tag or ""
        # Abbreviate session_id (slot:cid:ts → cid12) for display.
        sess_short = "-"
        if sess:
            parts = sess.split(":")
            sess_short = parts[1] if len(parts) >= 2 else sess[:12]
        if err:
            print(f"  {rid:>4}  {ts:<20}  {slot:<10}  {model:<28}  "
                  f"{'-':>6}  {'-':>4}  {kv:<9}  "
                  f"{'-':>7}  {'-':>7}  {'-':>8}  {'-':>8}  "
                  f"{sess_short:<14}  ERROR: {err}")
            continue
        pps_s = f"{pps:.1f}" if pps is not None else "-"
        prs_s = f"{prs:.1f}" if prs is not None else "-"
        print(f"  {rid:>4}  {ts:<20}  {slot:<10}  {model:<28}  "
              f"{(ctx if ctx is not None else '-'):>6}  "
              f"{(nmax if nmax is not None else '-'):>4}  "
              f"{kv:<9}  "
              f"{(pt if pt is not None else '-'):>7}  "
              f"{(gt if gt is not None else '-'):>7}  "
              f"{pps_s:>8}  {prs_s:>8}  "
              f"{sess_short:<14}  {tag}")


def cmd_show(args):
    conn = db_connect()
    cur = conn.execute("SELECT * FROM runs WHERE id = ?", (args.id,))
    row = cur.fetchone()
    if not row:
        sys.exit(f"no run with id {args.id}")
    cols = [d[0] for d in cur.description]
    json_cols = {"cmd_argv", "flags", "overrides",
                 "generation_settings", "props", "timings"}
    for k, v in zip(cols, row):
        if k in json_cols and v:
            try:
                v = json.dumps(json.loads(v), indent=2, sort_keys=True)
            except Exception:
                pass
            print(f"{k}:")
            for line in str(v).splitlines():
                print(f"  {line}")
        else:
            print(f"{k}: {v}")


def cmd_db_path(_args):
    print(DB_PATH)


# ── /metrics scraper (option 1: passive throughput logger) ────────────────────

# Prometheus metric name → column name in metrics_samples. Anything in the
# /metrics text not in this map still ends up in `metrics_raw` for forward
# compatibility, but doesn't get a typed column.
METRIC_COLUMNS = {
    "llamacpp:prompt_tokens_total":         ("prompt_tokens_total", int),
    "llamacpp:tokens_predicted_total":      ("predicted_tokens_total", int),
    "llamacpp:prompt_seconds_total":        ("prompt_seconds_total", float),
    "llamacpp:tokens_predicted_seconds_total": ("predicted_seconds_total", float),
    "llamacpp:n_decode_total":              ("n_decode_total", int),
    "llamacpp:prompt_tokens_seconds":       ("prompt_tokens_per_second", float),
