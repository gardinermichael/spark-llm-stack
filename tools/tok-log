  renderChart('chart-timeline', 'line', {datasets}, {
    parsing: false,
    scales: {x: {type:'time', time:{tooltipFormat:'PP HH:mm:ss'}},
             y: {title:{display:true,text:'tokens/sec'}, beginAtZero:true}},
  });
}

async function loadKV() {
  const samples = await api('/api/samples', {limit: 20000});
  const valid = samples.filter(s => s.error==null && s.kv_cache_usage_ratio != null);
  const bySession = groupBy(valid, s => s.session_id || 'unknown');
  const datasets = [];
  let i = 0;
  for (const [sess, rows] of bySession) {
    const short = (sess.split(':')[1] || sess.slice(0,12));
    datasets.push({
      label: `${rows[0].slot}: ${short}`,
      data: rows.map(r => ({x: r.ts, y: r.kv_cache_usage_ratio * 100})),
      borderColor: palette[i % palette.length],
      backgroundColor: palette[i % palette.length] + '33',
      pointRadius: 1, borderWidth: 1.5, tension: 0.2, fill: false,
    });
    i++;
  }
  renderChart('chart-kv', 'line', {datasets}, {
    parsing: false,
    scales: {x: {type:'time'}, y:{min:0,max:100,title:{display:true,text:'KV cache used (%)'}}},
  });
}

async function loadCompare() {
  const runs = (await api('/api/runs', {limit: 2000})).filter(r => r.predicted_per_second != null);
  const key = $('cmp-group').value;
  const keyFn = key === 'config'
    ? r => `${r.model_name||'?'} / n_max=${r.spec_draft_n_max} / ${r.cache_type_k||'-'}/${r.cache_type_v||'-'}`
    : r => String(r[key] ?? '(null)');
  const groups = groupBy(runs, keyFn);
  const labels = [...groups.keys()];
  const avg = labels.map(k => {
    const xs = groups.get(k).map(r => r.predicted_per_second);
    return xs.reduce((a,b)=>a+b,0) / xs.length;
  });
  const counts = labels.map(k => groups.get(k).length);
  renderChart('chart-compare', 'bar', {
    labels,
    datasets: [{
      label: 'avg predicted_per_second',
      data: avg,
      backgroundColor: labels.map((_,i)=>palette[i%palette.length]),
    }],
  }, {
    scales: {y: {title:{display:true,text:'tokens/sec'}, beginAtZero:true}},
    plugins: {tooltip: {callbacks: {afterLabel: ctx => `n = ${counts[ctx.dataIndex]}`}}},
  });
}

function renderChart(id, type, data, options={}) {
  if (charts[id]) charts[id].destroy();
  charts[id] = new Chart($(id), {type, data, options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {legend: {labels: {color:'#e6edf3'}}, ...(options.plugins||{})},
    scales: Object.fromEntries(Object.entries(options.scales||{}).map(([k,v]) =>
      [k, {...v, ticks:{color:'#7d8590'}, grid:{color:'#30363d'}, title:{...(v.title||{}), color:'#7d8590'}}]
    )),
    ...Object.fromEntries(Object.entries(options).filter(([k]) => !['plugins','scales'].includes(k))),
  }});
}

