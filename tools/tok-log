    "coder":     8152,
    "architect": 8154,
    "gemma":     8156,
    "vision":    8155,
    "gptoss":    8157,
}

UNITS = {
    "coder":     "qwen27-mtp.service",
    "architect": "qwen35-mtp.service",
    "gemma":     "gemma-31b.service",
    "vision":    "gemma-vision.service",
    "gptoss":    "gptoss-20b.service",
}

CONTAINER_PREFIX = "spark-llm-"

DEFAULT_PROMPT = (
    "Write a short technical explanation of how speculative decoding "
    "improves throughput in transformer inference. Be concrete."
)

DB_PATH = Path(
    os.environ.get("TOK_LOG_DB")
    or (Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
        / "spark-llm-stack" / "token-speed.db")
)

