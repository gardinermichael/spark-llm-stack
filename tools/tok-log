def _rows_to_dicts(cursor):
    cols = [d[0] for d in cursor.description]
    return [dict(zip(cols, row)) for row in cursor.fetchall()]


def _api_slots(conn, _qs):
    cur = conn.execute(
        "SELECT DISTINCT slot FROM ("
        " SELECT slot FROM runs UNION SELECT slot FROM metrics_samples) "
        "ORDER BY slot")
    return [r[0] for r in cur.fetchall()]


def _api_models(conn, _qs):
    cur = conn.execute(
        "SELECT DISTINCT model_name FROM ("
        " SELECT model_name FROM runs WHERE model_name IS NOT NULL"
        " UNION SELECT model_name FROM metrics_samples WHERE model_name IS NOT NULL) "
        "ORDER BY model_name")
    return [r[0] for r in cur.fetchall()]


def _api_sessions(conn, qs):
    where = ["session_id IS NOT NULL"]
    params = []
    if qs.get("slot"):
        where.append("slot = ?"); params.append(qs["slot"])
    if qs.get("model"):
        where.append("model_name = ?"); params.append(qs["model"])
    sql = ("SELECT session_id, slot, model_name, MIN(ts) AS first_ts, "
           "MAX(ts) AS last_ts, COUNT(*) AS samples "
           "FROM metrics_samples WHERE " + " AND ".join(where) +
           " GROUP BY session_id ORDER BY last_ts DESC")
    return _rows_to_dicts(conn.execute(sql, params))


def _filter_where(qs, prefix=""):
    """Build a WHERE clause and params from common filter keys."""
    where, params = [], []
    p = prefix
    if qs.get("slot"):
        where.append(f"{p}slot = ?"); params.append(qs["slot"])
    if qs.get("model"):
        where.append(f"{p}model_name = ?"); params.append(qs["model"])
    if qs.get("session"):
        where.append(f"{p}session_id = ?"); params.append(qs["session"])
    if qs.get("tag"):
        where.append(f"{p}tag = ?"); params.append(qs["tag"])
    if qs.get("since"):
        where.append(f"{p}ts >= ?"); params.append(qs["since"])
    if qs.get("until"):
        where.append(f"{p}ts <= ?"); params.append(qs["until"])
    return where, params


def _api_runs(conn, qs):
    where, params = _filter_where(qs)
    # tag/model/session/slot/ts all exist on runs; reuse the same builder.
    sql = ("SELECT id, ts, slot, port, session_id, tag, model_name, model_alias, "
           "n_ctx, n_batch, n_ubatch, n_parallel, n_gpu_layers, flash_attn, "
           "cache_type_k, cache_type_v, cache_ram, cache_reuse, ctx_checkpoints, "
           "kv_unified, spec_type, spec_draft_n_max, spec_draft_n_min, spec_draft_p_min, "
           "threads, threads_batch, temp, top_k, top_p, min_p, "
           "reasoning, reasoning_budget, reasoning_format, "
           "n_predict_req, prompt_tokens, predicted_tokens, "
           "prompt_ms, predicted_ms, prompt_per_second, predicted_per_second, "
           "wall_ms, error "
           "FROM runs")
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY id DESC LIMIT ?"
    params.append(int(qs.get("limit", 200)))
    return _rows_to_dicts(conn.execute(sql, params))


def _api_run(conn, qs):
    if "id" not in qs:
        return {"error": "missing id"}
    cur = conn.execute("SELECT * FROM runs WHERE id = ?", (int(qs["id"]),))
    rows = _rows_to_dicts(cur)
    return rows[0] if rows else {"error": "not found"}


def _api_samples(conn, qs):
    where, params = _filter_where(qs)
    sql = ("SELECT id, ts, slot, session_id, model_name, "
           "prompt_tokens_total, predicted_tokens_total, "
           "prompt_seconds_total, predicted_seconds_total, "
           "prompt_tokens_per_second, predicted_tokens_per_second, "
           "kv_cache_usage_ratio, kv_cache_tokens, "
           "requests_processing, requests_deferred, error "
           "FROM metrics_samples")
    if where:
        sql += " WHERE " + " AND ".join(where)
    sql += " ORDER BY id ASC LIMIT ?"
    params.append(int(qs.get("limit", 5000)))
    return _rows_to_dicts(conn.execute(sql, params))


