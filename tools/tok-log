def parse_prometheus(text):
    """Return {metric_name: float_value}. Strips comments + labels."""
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # name{labels} value  OR  name value
        # Strip the label block if present (llamacpp doesn't use labels but
        # be defensive). Use split-on-first '{' and rsplit-on-last '}' so an
        # embedded brace inside a quoted label value doesn't truncate the
        # metric name.
        if "{" in line and "}" in line:
            head = line.split("{", 1)[0]
            after = line.rsplit("}", 1)[-1]
            line = head + after
        parts = line.split()
        if len(parts) < 2:
            continue
        name, value = parts[0], parts[-1]
        try:
            out[name] = float(value)
        except ValueError:
            continue
    return out


def fetch_metrics(host, port, timeout=5):
    url = f"http://{host}:{port}/metrics"
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return r.read().decode("utf-8")


def _discover_session(slot, no_docker=False, no_systemd=False):
    """Return (session_id, model_name) without re-running the bench parser."""
    if not no_docker:
        argv, sess = docker_inspect_cmd(slot)
        if argv:
            _, model_name, _, _ = parse_argv_to_flags(argv)
            return sess, model_name
    if not no_systemd:
        argv, sess = systemd_show_cmd(slot)
        if argv:
            _, model_name, _, _ = parse_argv_to_flags(argv)
            return sess, model_name
    return None, None


def cmd_watch(args):
    if args.slot not in PORTS:
        sys.exit(f"unknown slot {args.slot!r}; known: {', '.join(PORTS)}")
    port = PORTS[args.slot]
    host = args.host

    # Discover session once; refresh only if we detect a restart (sample
    # error then recovery is a cheap proxy for "container changed").
    session_id, model_name = _discover_session(
        args.slot, no_docker=args.no_docker, no_systemd=args.no_systemd)

    conn = db_connect()
    print(f"watching {args.slot} @ {host}:{port}  interval={args.interval}s  "
          f"session={session_id or '?'}  (Ctrl+C to stop)")

    samples_written = 0
    last_was_error = False
    consecutive_errors = 0
    try:
        while True:
            ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
            err = None
            raw = ""
            metrics = {}
            try:
                raw = fetch_metrics(host, port, timeout=args.timeout)
                metrics = parse_prometheus(raw)
            except Exception as e:
                err = f"{type(e).__name__}: {e}"

            # If we recovered from an error, the container may have been
            # restarted — re-discover the session.
            if err is None and last_was_error:
                session_id, model_name = _discover_session(
                    args.slot, no_docker=args.no_docker, no_systemd=args.no_systemd)
            last_was_error = err is not None
            consecutive_errors = consecutive_errors + 1 if err else 0

            row = {
                "ts": ts, "slot": args.slot, "port": port, "host": host,
                "session_id": session_id, "model_name": model_name,
                "metrics_raw": json.dumps(metrics, sort_keys=True) if metrics else None,
                "error": err,
            }
            for metric_name, (col, conv) in METRIC_COLUMNS.items():
                v = metrics.get(metric_name)
                if v is None:
                    row[col] = None
                else:
                    try:
                        row[col] = conv(v)
                    except (TypeError, ValueError):
                        row[col] = None

            cols = ", ".join(row.keys())
            placeholders = ", ".join(["?"] * len(row))
            with conn:
                conn.execute(
                    f"INSERT INTO metrics_samples ({cols}) VALUES ({placeholders})",
                    list(row.values()),
                )
            samples_written += 1

            if args.verbose:
                if err:
                    print(f"  {ts}  ERROR {err}")
                else:
                    pps = row.get("predicted_tokens_per_second")
                    proc = row.get("requests_processing")
                    pt = row.get("predicted_tokens_total")
                    pps_s = f"{pps:.2f}" if isinstance(pps, (int, float)) else "-"
                    print(f"  {ts}  predicted_total={pt}  "
                          f"predicted_t/s={pps_s}  processing={proc}")

            if args.samples and samples_written >= args.samples:
                break
            if args.max_errors and consecutive_errors >= args.max_errors:
                if args.verbose:
                    print(f"  giving up after {consecutive_errors} consecutive errors")
                break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass

    print(f"\nwrote {samples_written} sample(s) to {DB_PATH}")


def cmd_metrics(args):
    """One-shot: fetch /metrics and print parsed values (no DB write)."""
    if args.slot not in PORTS:
        sys.exit(f"unknown slot {args.slot!r}; known: {', '.join(PORTS)}")
    port = PORTS[args.slot]
    raw = fetch_metrics(args.host, port, timeout=5)
    metrics = parse_prometheus(raw)
    if args.json:
        print(json.dumps(metrics, indent=2, sort_keys=True))
        return
    for k in sorted(metrics):
        print(f"  {k:<48}  {metrics[k]}")


def cmd_samples(args):
    conn = db_connect()
    q = ("SELECT id, ts, slot, model_name, predicted_tokens_total, "
         "predicted_tokens_per_second, requests_processing, "
         "kv_cache_usage_ratio, session_id, error "
         "FROM metrics_samples")
    params, wheres = [], []
    if args.slot:
        wheres.append("slot = ?"); params.append(args.slot)
    if args.session:
        wheres.append("session_id = ?"); params.append(args.session)
    if wheres:
        q += " WHERE " + " AND ".join(wheres)
    q += " ORDER BY id DESC LIMIT ?"
    params.append(args.limit)
    rows = conn.execute(q, params).fetchall()
    if not rows:
