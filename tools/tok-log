        return
    print(f"  {'id':>5}  {'ts':<20}  {'slot':<10}  {'model':<24}  "
          f"{'pred tot':>10}  {'pred t/s':>9}  {'proc':>4}  {'kv%':>5}  sess")
    for r in rows:
        rid, ts, slot, model, pt, pps, proc, kv, sess, err = r
