#!/usr/bin/env python3
# tok-log — record llama-server token-speed benchmarks into SQLite.
#
# Usage:
#   tok-log bench <slot> [--prompt "..."] [--n-predict 256] [--tag note]
#   tok-log list  [--slot X] [--limit 20]
#   tok-log show  <id>
#   tok-log db-path
#
# What it records:
#   - Timings from POST /completion (prompt + predicted tokens/sec).
#   - Full effective argv of the running server, captured from:
#       1. `docker inspect spark-llm-<slot>` (docker path), or
#       2. `systemctl --user show <unit> -p ExecStart` (systemd path),
#       3. /props as a last-resort fallback.
#     The argv is parsed into a flag→value JSON map so any flag from
#     `docker-llm-switch <slot> config` (and beyond — --cache-type-k,
#     --kv-unified, --cache-reuse, --spec-draft-n-max, …) is queryable
#     via json_extract.
#   - Model name (basename of `-m` or value of `-hf`) as its own column.
#   - Active override file from
#     ${XDG_CONFIG_HOME:-~/.config}/docker-llm-switch/overrides/<slot>.
#
# Slots and ports mirror systemd/llm-switch :: PORTS. Keep in sync when
# adding a slot (see CLAUDE.md "How slots are defined"). Llama slots only.

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

