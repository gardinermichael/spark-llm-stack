def cmd_serve(args):
    import http.server
    import urllib.parse
    from socketserver import ThreadingMixIn

    HTML = _build_html()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, fmt, *a):
            if args.verbose:
                sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % a))

        def _send_json(self, obj, code=200):
            body = json.dumps(obj, default=str).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _send_text(self, text, ctype="text/html; charset=utf-8", code=200):
            body = text.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            path = parsed.path
            qs = {k: v[0] for k, v in urllib.parse.parse_qs(parsed.query).items()}
            if path in ("/", "/index.html"):
                return self._send_text(HTML)
            if path in API_ROUTES:
                conn = db_connect()
                try:
                    result = API_ROUTES[path](conn, qs)
                except Exception as e:
                    return self._send_json({"error": f"{type(e).__name__}: {e}"}, 500)
                finally:
                    conn.close()
                return self._send_json(result)
            self._send_text("404", "text/plain", 404)

    class ThreadingServer(ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True

    server = ThreadingServer((args.host, args.port), Handler)
    url = f"http://{args.host}:{args.port}"
    print(f"tok-log serve: {url}  (db: {DB_PATH})")
    print("Ctrl+C to stop.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


def main():
    p = argparse.ArgumentParser(prog="tok-log",
                                description="Record llama-server token-speed benchmarks to SQLite.")
    sub = p.add_subparsers(dest="cmd", required=True)

    b = sub.add_parser("bench", help="run a benchmark prompt against a slot and log it")
    b.add_argument("slot", help=f"one of: {', '.join(PORTS)}")
    b.add_argument("--prompt", help="prompt text (default: built-in spec-decoding prompt)")
    b.add_argument("--n-predict", type=int, default=256, help="tokens to generate (default 256)")
    b.add_argument("--host", default="127.0.0.1")
    b.add_argument("--timeout", type=int, default=600, help="request timeout seconds")
    b.add_argument("--tag", help="free-form label (e.g. 'mtp-n3', 'after-rebuild')")
    b.add_argument("--no-docker", action="store_true",
                   help="skip docker inspect when discovering effective argv")
    b.add_argument("--no-systemd", action="store_true",
                   help="skip systemctl when discovering effective argv")
    b.set_defaults(func=cmd_bench)

    l = sub.add_parser("list", help="show recent runs")
    l.add_argument("--slot")
    l.add_argument("--model", help="substring match on model_name")
    l.add_argument("--session", help="exact match on session_id")
    l.add_argument("--limit", type=int, default=20)
    l.set_defaults(func=cmd_list)

    s = sub.add_parser("show", help="dump a single run with full config")
    s.add_argument("id", type=int)
    s.set_defaults(func=cmd_show)

    d = sub.add_parser("db-path", help="print the SQLite DB path")
    d.set_defaults(func=cmd_db_path)

    w = sub.add_parser("watch", help="passively log /metrics samples to SQLite")
    w.add_argument("slot", help=f"one of: {', '.join(PORTS)}")
    w.add_argument("--interval", type=int, default=10,
                   help="poll interval seconds (default 10)")
    w.add_argument("--samples", type=int,
                   help="stop after N samples (default: run until Ctrl+C)")
    w.add_argument("--host", default="127.0.0.1")
    w.add_argument("--timeout", type=int, default=5)
    w.add_argument("--verbose", action="store_true",
                   help="print each sample as it's written")
    w.add_argument("--max-errors", type=int, default=12,
                   help="exit after N consecutive fetch failures (default 12 = ~2min "
                        "at the default interval; 0 disables)")
    w.add_argument("--no-docker", action="store_true")
    w.add_argument("--no-systemd", action="store_true")
    w.set_defaults(func=cmd_watch)

    m = sub.add_parser("metrics", help="one-shot fetch + parse of /metrics (no DB write)")
    m.add_argument("slot", help=f"one of: {', '.join(PORTS)}")
    m.add_argument("--host", default="127.0.0.1")
    m.add_argument("--json", action="store_true", help="output as JSON")
    m.set_defaults(func=cmd_metrics)

    sa = sub.add_parser("samples", help="show recent /metrics samples")
    sa.add_argument("--slot")
    sa.add_argument("--session", help="exact match on session_id")
    sa.add_argument("--limit", type=int, default=20)
    sa.set_defaults(func=cmd_samples)

    sv = sub.add_parser("serve", help="start the web UI over the SQLite log")
    sv.add_argument("--host", default="127.0.0.1",
                    help="bind address (default 127.0.0.1; use 0.0.0.0 for LAN/Tailscale)")
    sv.add_argument("--port", type=int, default=8765,
                    help="port (default 8765; avoids llama 8152-8160 and ComfyUI 8188)")
    sv.add_argument("--verbose", action="store_true", help="log every HTTP request")
    sv.set_defaults(func=cmd_serve)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
